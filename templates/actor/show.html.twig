{# templates/actor/show.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/actor.css') }}" rel="stylesheet" />
{% endblock %}

{% block js %}
{{ parent() }}

{% endblock %}

{% block body %}
   <div id="actor" >
          <div class="subheading" >
                 <div class="title">Actor </div>
                 <div class="returnbutton button1">  <a   href = "/actor/delete/{{actor.actorid}}" >delete </a> </div>
                 <div class="returnbutton">  <a   href = "/actor/edit/{{actor.actorid}}" >edit </a> </div>
                 <div class="returnbutton">  <a   href = "/actor/editroles/{{actor.actorid}}" >edit roles </a> </div>
                 <div class="returnbutton"><a  href = "/actor/new" >Add New actor </a> </div>
                  <div class="returnbutton"><a  href = "/actor/maketree/{{actor.actorid}}" >Show Tree </a> </div>
               </div>
       <div class="actor">
         <div class="actortable">
         <div class="row">
            <div class="inputpair" >
                <div class="label">ID </div>
                <div class= "field"> {{actor.actorid}}</div>
            </div>
        </div>
        <div class="row">
            <div class="namepair inputpair" >
                <div class="label">name</div>
                <div class= "field"> {{actor.surname}}, {{actor.forename}} </div>
            </div>
            <div class="inputpair" >
                <div class="label"> specifier </div>
                <div class= "longfield"> {{actor.specifier}} </div>
            </div>
        </div>
        <div class="row">
            <div class="inputpair" >
                <div class="label">birthdate</div>
                {% if actor.birthdate is not null  %}
                <div class= "field"> {{actor.Birthdate}} </div>
                {% else %}
                <div class= "field">  </div>
                {% endif %}
            </div>
            <div class="inputpair" >
                <div class="label"> deathdate</div>
                <div class= "field"> {{actor.deathdate}} </div>
            </div>
           <div class="inputpair" >
                        <div class="label"> Gender</div>
                        <div class= "field"> {{actor.gender}} </div>
          </div>
        </div>
        <div class="row">

            <div class="inputpair" >
                <div class="label"> text </div>
                <div class= "longfield"> {{actor.text}} </div>
            </div>
        </div>
    </div>

        <div class="subheading" >
            <div class="title">Life Events </div>
        </div>
        <div class="eventTable" >
           <div class="body">
                        {% for eid, levent in lifeevents %}
                                      <div class="row">
                                           <div class="date">{{levent.lowdate}} </div>
                                          {% if(levent.middate != levent.lowdate )  %}
                                              <div class="date">{{levent.middate}} </div>
                                          {% endif %}
                                         {% if(levent.middate != levent.highdate )  %}
                                          <div class="date">{{levent.highdate}} </div>
                                           {% endif %}
                                           <div class="type">{{levent.eventtype}} </div>
                                           <div class="role">{{levent.role}} </div>
                                           <div class="text">{{levent.subject}} </div>
                                          {% set cluelist = levent.clues|split(',') %}
                                           {% for clue in cluelist %}
                                           <div class="returnbutton" ><a   href = "/glimpse/showone/{{clue}}" >Clue_{{clue}}</a> </div>
                                              {% endfor %}

                                      </div>
                       {% endfor %}
                  </div>
        </div>
        <div class="subheading" >
            <div class="title">Relationships</div>
        </div>
        <div class="relationTable" >
            <div class="list">
                {% for rid, relation in relations %}
                <div class="row">
                   <div class="returnbutton">  <a   href = "/relation/show/{{relation.relationid}}" >View</a> </div>
                   <div class="returnbutton">
                     <a   href = "/actor/showone/{{relation.actor1ref}}" >{{actors[relation.actor1ref].label}} </a>
                   </div>
                   <div class="cell">  is {{relation.relation}} of </div>
                  {% if actors[relation.actor2ref] is defined %}
                   <div class="returnbutton">  <a   href = "/actor/showone/{{relation.actor2ref}}" >{{actors[relation.actor2ref].label}}</a> </div>
                   <div class="cell">  Clues </div>
                   {% set clues = relation.Clues |split(",") %}
                   {% for aclue in clues %}
                   <div class="returnbutton">  <a   href = "/glimpse/showone/{{aclue}}" >Clue {{aclue}}</a> </div>
                   {% endfor %}
                   {% else %}
                    <div class="cell"> Actor {{relation.actor2ref}} not found </div>
                   {% endif %}
              </div>
                    {% endfor %}
                </div>
            </div>
            <div class="subheading" >
                <div class="title">Roles </div>
            </div>
            <div class="roleTable" >
                    {% for pid, glimpse in roles %}
                    <div class="row">
                         <div class="returnbutton">  <a   href = "/glimpse/showone/{{glimpse.glimpseid}}" >View</a> </div>
                    {% set formatedtext = FormatRoleFull(glimpse,pid) %}
                        <div class="text" >{{formatedtext}}</div>
                        <div class="age" >  Age: {{calAge(actor.Birthdate,glimpse.date)}} </div>
                       {#  <div class="cell">{{glimpse.predicates}} </div>#}
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}




