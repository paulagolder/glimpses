{# templates/actor/showall.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/actor.css') }}" rel="stylesheet" />

{% endblock %}

{% block js %}
{{ parent() }}

{% endblock %}

{% block body %}
<div id="actor" >

    <div class="heading">
      <div class="title">Actors</div>
         <div class='returnbutton  '>
                     <a  href = "/actor/new" >New Actor</a>
                 </div>
             <div class='returnbutton  '>
                                  <a  href = "/actor/updategender" >Update Gender</a>
             </div>
      </div>
<div class="filterform" >
<form  action="/actor/setfilter">
     <div class="filterrow">
      <div class="label"> Filter</div>
      <input type="text" name="filter" value="{{filter}}" />
      <input type="submit" value="action" />
       <div class="clearbutton">   <a   href = "/actor/clearfilter" >Clear</a> </div>
         <div class="count"> ( Count={{actors | length}} ) </div>
      </div>
      </form>
  </div>

<div class= "list">
    {% for actor in actors %}
        <div class="row ">
             <div class="returnbutton col1">   <a   href = "/actor/showone/{{actor.actorid}}" >view </a> </div>
            <div class= "cid">{{actor.actorId}}</div>
          {%  if(actor.gender=="female") %}
             <div class= "clname female">
          {% elseif(actor.gender=="male") %}
              <div class= "clname male">
          {% else %}
             <div class= "clname">
           {% endif %}
            {{actor.getLabel}}</div>
            <div class= "mtext"> {{actor.specifier}}</div>
        </div>
    {% endfor %}
       </div>
</div>
{% endblock %}


