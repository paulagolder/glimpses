{# templates/actor/editroles.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/actor.css') }}" rel="stylesheet" />
{% endblock %}

{% block js %}
{{ parent() }}
{% endblock %}

{% block body %}
<div id="actor" >
    <div class ="heading" >
        <div class="title">Actor:</div>
        <div class= "field">{{actor.surname}}, {{actor.forename}}</div>
        <div class="returnbutton button1"> <a href = "/actor/showone/{{actor.actorid}}" >return </a> </div>
        <div class="returnbutton">  <a   href = "/actor/delete/{{actor.actorid}}" >delete </a> </div>
        <div class="returnbutton">  <a   href = "/actor/edit/{{actor.actorid}}" >edit </a> </div>
        <div class="returnbutton"><a  href = "/actor/new" >Add New actor </a> </div>
    </div>
    {% dump(actor) %}

        <div class="actor">
             <div class="actortable">
            <div class="row">
                <div class="inputpair" >
                    <div class="label">ID </div>
                    <div class= "field"> {{actor.actorid}}</div>
                </div>
            </div>
            <div class="row">
                <div class="inputpair" >
                    <div class="label">name</div>
                    <div class= "field"> {{actor.surname}}, {{actor.forename}}</div>
                </div>
                <div class="inputpair" >
                    <div class="label"> specifier </div>
                    <div class= "labelfield"> {{actor.specifier}} </div>
                </div>
            </div>
            <div class="row">
                <div class="inputpair" >
                    <div class="label">birthdate</div>
                    {% if actor.birthdate is not null  %}
                    <div class= "field"> {{actor.Birthdate}} </div>
                    {% else %}
                    <div class= "field"> "Null"" </div>
                    {% endif %}
                </div>
                <div class="inputpair" >
                    <div class="label"> deathdate</div>
                    <div class= "field"> {{actor.deathdate}} </div>
                </div>
            </div>
            <div class="row">
                <div class="inputpair" >
                    <div class="label"> text </div>
                    <div class= "longfield"> {{actor.text}} </div>
                </div>
            </div>
        </div>
  </div>


        <div class="subheading" >
            <div class="title"> Matches? </div>
        </div>
    <div class="matchTable" >
        <div class="body">
            {% for aid, anactor in duplicates %}
                {%  if( anactor.actorid != actor.actorid ) %}
            <div class="row">
                <div class="cellid"> {{anactor.actorid}}</div>
                <div class="cell">{{anactor.surname}}, {{anactor.forename}}</div>
                <div class="cell">({{anactor.birthdate}}-{{anactor.deathdate}}) </div>
                <div class="returnbutton">  <a   href = "/actor/compare/{{actor.actorid}}/{{anactor.actorid}}" >Compare</a> </div>
            </div>
           {% endif %}
            {% endfor %}
        </div>
    </div>


        <div class="subheading" >
            <div class="title"> Life Events </div>
            <div class="returnbutton">  <a   href = "/actor/newevent/{{actor.actorid}}" >New Event</a> </div>
        </div>
     <div class="eventTable" >
        <div class="body">
              {% for eid, levent in lifeevents %}
                            <div class="row">
                                   <div class="returnbutton">  <a   href = "/actor/deleteevent/{{levent.lifeeventid}}" >delete</a> </div>
                                 <div class="date">{{levent.lowdate}} </div>
                                {% if(levent.middate != levent.lowdate )  %}
                                    <div class="date">{{levent.middate}} </div>
                                {% endif %}
                               {% if(levent.middate != levent.highdate )  %}
                                <div class="date">{{levent.highdate}} </div>
                                 {% endif %}
                                 <div class="type">{{levent.eventtype}} </div>
                                 <div class="date">{{levent.role}} </div>
                                {% set cluelist = levent.clues|split(',') %}

                                 {% for clue in cluelist %}
                                 <div class="returnbutton" ><a   href = "/glimpse/showone/{{clue}}" >Clue_{{clue}}</a> </div>
                                    {% endfor %}

                            </div>
             {% endfor %}
        </div>
    </div>

        <div class="subheading" >
            <div class="title">Relationships</div>
                <div class="returnbutton">  <a   href = "/actor/newrelationship/{{actor.actorid}}" >New Relationship</a> </div>
        </div>

    <div class="relationTable" >
        <div class="body">
            {% for rid, relation in relations %}

                <div class="row">
                      <div class="returnbutton">  <a   href = "/actor/deleterelation/{{actor.actorid}}/{{rid}}" >delete</a> </div>
                               <div class="actor">{{actors[relation.actor1ref].getName()}} </div>
                               <div class="relation">is {{relation.relation}} of </div>
                              <div class="actor">{{actors[relation.actor2ref].getName()}} </div>
                                  {% set cluelist = relation.clues|split(',') %}
                           {% for clue in cluelist %}
                              <div class="returnbutton" ><a   href = "/glimpse/showone/{{clue}}" >Clue_{{clue}}</a> </div>
                           {% endfor %}
                           </div>
                {% endfor %}
            </div>
        </div>
      <div class="subheading" >
                <div class="title">Roles</div>
            </div>
    <div class="roleTable" >
        <div class="body">
            {% dump(roles) %}
            {% for pid, arole in roles %}
            <div class="row">
                <div class="returnbutton">  <a   href = "/actor/deleterole/{{actor.actorid}}/{{pid}}" >remove </a> </div>
                <div class="returnbutton">  <a   href = "/glimpse/showone/{{arole.glimpseid}}" >view </a> </div>
                 <div class="returnbutton">  <a   href = "/actor/newrelationshipwithglimpse/{{actor.actorid}}/{{arole.glimpseid}}" >Make Reln </a> </div>
                  {% set formatedtext = FormatRoleFull(arole,pid) %}
                <div class="cell" >{{formatedtext}}</div>
               {% if(actor.Birthdate != null) %}
                {
                  <div class="cell" >Age:  {{calAge(actor.Birthdate,arole.date)}} </div>
                }

           {% endif %}
            </div>
            {% endfor %}
        </div>
</div>


        <div class="subheading" >
            <div class="title">Candidate Glimspes </div>
        </div>
     <div class= "cglimpsestable">

            {% for pid, cglimpse in cglimpses %}
               {%  set   age= calAge(actor.Birthdate,cglimpse.date) %}
               {%   if (age > -10) and ( age <110 ) %}
            <div class= "cgrow">
               <div class="returnbutton"><a   href = "/actor/addrole/{{actor.actorid}}/{{pid}}" >Add </a> </div>
                <div class="returnbutton" ><a  href = "/glimpse/showone/{{cglimpse.getGlimpseId()}}" >View</a></div>
                {% set formatedtext = FormatEventFull(cglimpse,pid) %}
                <div class="glimpsetext" >{{formatedtext}}</div>
                <div class="agecell" > AGE: {{age}} </div>
            </div>
        {% endif %}
            {% endfor %}
        </div>
</div>
{% endblock %}




