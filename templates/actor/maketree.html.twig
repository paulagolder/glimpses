{# templates/actor/show.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/actor.css') }}" rel="stylesheet" />
{% endblock %}

{% block js %}
{{ parent() }}

{% endblock %}

{% block body %}
   <div id="actor" >
          <div class="subheading" >
                 <div class="title">Actor </div>
                 <div class="returnbutton button1">  <a   href = "/actor/showone/{{actor.actorid}}" >Returm </a> </div>
               </div>
       <div class="actor">
         <div class="table">

        <div class="row">
                <div class="label">name</div>
                <div class= "cname"> {{actor.surname}}, {{actor.forename}} </div>
                <div class="label"> specifier </div>
                <div class= "cltext"> {{actor.specifier}} </div>
        </div>
        <div class="row">
                <div class="label">birthdate</div>
                {% if actor.birthdate is not null  %}
                <div class= "cdate"> {{actor.Birthdate}} </div>
                {% else %}
                <div class= "cid"> "Null"" </div>
                {% endif %}
                <div class="label"> deathdate</div>
                <div class= "cdate"> {{actor.deathdate}} </div>
        </div>
    </div>
    <div class="subheading" >
        <div class="title">Parents</div>
    </div>
        <div class="list" >
                {% for eid , parent  in parents %}
                   <div class="row">
                       <div class="clname">{{parent.getLabel()}} </div>
                   </div>
                {% endfor %}
         </div>
   <div class="subheading" >
         <div class="title">Spouses</div>
   </div>
        <div class="list" >
                {% for eid , spouse  in wives %}
                   <div class="row">
                       <div class="clname">{{spouse.getLabel()}} </div>
                   </div>
                {% endfor %}
                {% for eid , spouse  in husbands %}
                     <div class="row">
                         <div class="clname">{{spouse.getLabel()}} </div>
                     </div>
                {% endfor %}
              </div>

    </div>

<div class="subheading" >
            <div class="title">Children</div>
</div>
        <div class="list" >
                {% for eid , child  in children %}
                   <div class="row">
                       <div class="clname">{{child.getLabel()}} </div>
                   </div>
                {% endfor %}
    </div>
</div>
{% endblock %}




