{# templates/actor/edit.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/actor.css') }}" rel="stylesheet" />
{% endblock %}

{% block js %}
{{ parent() }}

{% endblock %}

{% block body %}
<div id="actor" >
    <div class ="heading" >
       <div class="title"> Edit Actor </div>
        <div class="returnbutton button1"> <a class="button" href = "/actor/showone/{{actor.actorid}}" >Return </a> </div>
        <div class="returnbutton "> <a class="button" href = "/actor/new" >Add New Actor </a> </div>
    </div>
    <div class="input table">
        <form action="/actor/process_edit/{{actor.actorid}}" method="post" id="actorform"  >
            <div class="row">
                <div class="label">ID </div>
                <div class= "mfield"> <input class="iid" type="text" name="_actorid" value="{{actor.actorid}}" /> </div>
            </div>
            <div class="row">
                <div class="label">Surname</div>
                <div class= "mfield"> <input class="iname" type="text" name="_surname" value="{{actor.surname}}" /> </div>
                <div class="label">forename</div>
                <div class= "mfield"> <input class="iname" type="text" name="_forename" value="{{actor.forename}}" /> </div>
                <div class="label">Specifier</div>
                <div class= "mfield"> <input class="imtext" type="text" name="_specifier" value="{{actor.specifier}}" /> </div>
             </div>
              <div class="row">
                 <div class="label">Birthdate</div>
                 <div class= "mfield"> <input class="idate" type="text" name="_birthdate" value="{{actor.birthdate}}" /> </div>
                 <div class="label">Deathdate</div>
                 <div class= "mfield"> <input class="idate" type="text" name="_deathdate" value="{{actor.deathdate}}" /> </div>
                 <div class="label">Gender</div>
                  <div class= "field"> <input class="iid" type="text" name="_gender" value="{{actor.gender}}" /> </div>
               </div>
               <div class="row">
                   <div class="label">Text</div>
                   <div class= "iltext"> <input class="ltext" type="text" name="_text" value="{{actor.text}}" /> </div>
                </div>
                <div class="row">
                    <div class="label">Key words</div>
                    <div class= "imtext"> <input class="imtext" type="text" name="_keywords" value="{{actor.keywords}}" /> </div>
                 </div>
              <button type="submit" id="submitbutton"   > enregistrer</button>
       </form>
       </div>
       </div>
{% endblock %}



