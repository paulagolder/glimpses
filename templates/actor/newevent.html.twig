{# templates/actor/editroles.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/actor.css') }}" rel="stylesheet" />
{% endblock %}

{% block js %}
{{ parent() }}
{% endblock %}

{% block body %}
<div id="actor" >
    <div class ="heading" >
        <div class="title">Actor:</div>
        <div class= "field">{{actor.surname}}, {{actor.forename}}</div>
        <div class="returnbutton button1"> <a href = "/actor/showone/{{actor.actorid}}" >return </a> </div>
        <div class="returnbutton">  <a   href = "/actor/delete/{{actor.actorid}}" >delete </a> </div>
        <div class="returnbutton">  <a   href = "/actor/edit/{{actor.actorid}}" >edit </a> </div>
        <div class="returnbutton"><a  href = "/actor/new" >Add New actor </a> </div>
    </div>
    {% dump(actor) %}
    {% dump(actors) %}
     {% dump(actorsindexed) %}
        <div class="actortable">
            <div class="row">
                <div class="inputpair" >
                    <div class="label">ID </div>
                    <div class= "field"> {{actor.actorid}}</div>
                </div>
            </div>
            <div class="row">
                <div class="inputpair" >
                    <div class="label">name</div>
                    <div class= "field"> {{actor.surname}}, {{actor.forename}} </div>
                </div>
                <div class="inputpair" >
                    <div class="label"> specifier </div>
                    <div class= "longfield"> {{actor.specifier}} </div>
                </div>
            </div>
            <div class="row">
                <div class="inputpair" >
                    <div class="label">birthdate</div>
                    {% if actor.birthdate is not null  %}
                    <div class= "field"> {{actor.Birthdate}} </div>
                    {% else %}
                    <div class= "field"> "Null"" </div>
                    {% endif %}
                </div>
                <div class="inputpair" >
                    <div class="label"> deathdate</div>
                    <div class= "field"> {{actor.deathdate}} </div>
                </div>
            </div>
            <div class="row">
                <div class="inputpair" >
                    <div class="label"> text </div>
                    <div class= "longfield"> {{actor.text}} </div>
                </div>
            </div>
        </div>

 <div class ="heading" >
    <div class="title">Events</div>
 </div>

 <div class="subheading" >
     <div class="title">Life Events </div>
 </div>
 <div class="eventTable" >
            <div class="body">
                {% for eid, levent in lifeevents %}
                <div class="row">
                    <div class="type">{{levent.eventtype}} </div>
                     <div class="date">{{levent.lowdate}} </div>
                    {% if(levent.middate != levent.lowdate )  %}
                        <div class="date">{{levent.middate}} </div>
                    {% endif %}
                   {% if(levent.middate != levent.highdate )  %}
                    <div class="date">{{levent.highdate}} </div>
                     {% endif %}
                </div>
                {% endfor %}
            </div>
 </div>


 <div class ="heading" >
      <div class="title">Glimpse </div>
      <div>{{glimpse.glimpseid}}</div>
 </div>
 <div class="actortable">
        <div class="row">
              <div class="inputpair" >
                  <div class="label"> type </div>
                  <div class= "field"> {{glimpse.type}} </div>
              </div>
              <div class="inputpair" >
                   <div class="label"> location </div>
                    <div class= "longfield"> {{glimpse.location}}</div>
              </div>
        </div>
        <div class="row">
            <div class="inputpair" >
                 <div class="label"> date </div>
                 <div class= "field"> {{glimpse.date}} </div>
            </div>
            <div class="inputpair" >
                  <div class="label"> text </div>
                  <div class= "longfield"> {{glimpse.text}} </div>
            </div>
        </div>
    </div>
        <div class="subheading" >
               <div class="title"> roles </div>
        </div>
       <div class="roleTable" >
                             {% for role in glimpse.roles %}
                             <div  class="row" >
                                 <div class="col1" >  </div>
                                 <div  class="col2"  > {{role.roleid}} </div>
                                 <div  class="col3" >{{role.role}}</div>
                                 <div  class="col4" >{{role.name}} </div>
                                 <div  class="col5" >{{role.predicates}} </div>
                             </div>
                          {% endfor %}
       </div>
    <div class="subheading" >
        <div class="title">Make New Relationships</div>
    </div>
        <div class="newrelationship">
            <form action="/actor/process_newrelationship/{{actor.actorid}}" method="post" id="relationshipform"  >
                <div class="row">
                       <div class="idpair" >
                    <div class="label">ID </div>
                    <div class= "field">{{actor.actorid}}</div>
                </div>
                <div class="namepair" >
                        <div class="label">Name</div>
                        <div class= "field">{{actor.surname}}, {{actor.forename}}</div>
            </div>
            <div class="relnpair" >
                <div class="label"> Relationship </div>
                <select name="_relationship">
                    <option selected="selected">Choose one</option>
                   {% for  relationship in relationships %}
                     <option value='{{relationship}}'>{{relationship}}</option>
                   {% endfor %}
                    </select>
            </div>
            <div class="actor2pair" >
                <div class="label"> of </div>
                <select name="_actor2ref">
                    <option selected="selected">Choose Actor</option>
                    {% for  actor in actors %}
                    <option value='{{actor.actorid}}'>{{actor.surname}}, {{actor.forename}}: {{actor.birthdate}}({{actor.specifier}})</option>
                    {% endfor %}
                </select>
            </div>
          <div class="cluepair" >
             <div class="label">Glimpse Clues </div>
             <div class= "field"> <input class="cellid" type="text" name="_relationclue" value="{{glimpse.glimpseid}}" /> </div>
          </div>
        </div>
        <button type="submit" id="submitbutton"   > enregistrer</button>
    </form>
    </div>
 <div class="subheading" >
        <div class="title">Make New Event</div>
    </div>
        <div class="newevent">
            <form action="/actor/process_newevent/{{actor.actorid}}" method="post" id="eventform"  >
                <div class="row">
              <div class="selrole" >
                                <div class="label"> Choose Role</div>
                                <select name="_selrole">
                                    <option selected="selected"></option>
                                    {% for  arole in glimpse.roles  %}
                                    <option value='{{arole.roleid}}'>{{arole.role}}, {{arole.name}}: ({{arole.predicates}})</option>
                                    {% endfor %}
                                </select>
                 </div>
                 <div class="glimpsetext" >
                                    <div class="label">Glimpse</div>
                                    <div class= "longfield">{{FormatEvent(glimpse)}}</div>

                  <div class= "field"> <input class="cellid" type="hidden"  name="_eventclue" value="{{glimpse.glimpseid}}" /> </div>
             </div>
            </div>
           </div>
        <button type="submit" id="submitbutton"   > enregistrer</button>
    </form>
    </div>
</div>
{% endblock %}




