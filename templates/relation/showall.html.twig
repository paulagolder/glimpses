{# templates/relation/show.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/relation.css') }}" rel="stylesheet" />
{% endblock %}

{% block js %}
{{ parent() }}

{% endblock %}

{% block body %}
<div id="relation">

    <div class ="heading" >
      <div class="title">Relations</div>
        <div class="returnbutton button1"> <a href = "/actor/showall" >return </a> </div>
    </div>

 <div class="filterform">
<form  action="/relation/setfilter">
  <div class="filterrow">
   <div class="label"> Filter</div>
   <input type="text" name="filter" value="{{filter}}" >
   <input type="submit" value="action" >
   <div class="clearbutton">   <a   href = "/relation/clearfilter" >Clear</a> </div>
   <div  class="count"  >(Count={{relations | length}})</div>
   </div>
   </form>
</div>

    <div class="relationlist" >
    {% for relation in relations %}
    <div class="row" >
     <div class="returnbutton"> <a href = "/relation/show/{{relation.relationid}}" >show </a> </div>
      {% if relation.actor1 is defined %}
         {% if relation.actor1 is not null %}
             {% if relation.actor2 is defined %}
                   {% if relation.actor2 is not null %}
                     <div>{{relation.actor1.label}} {{relation.relation}} {{relation.actor2.label}}</div>
                   {% endif %}
             {% endif %}
         {% endif %}
      {% endif %}
    </div>
    {% endfor %}
    </div>
</div>

{% endblock %}




