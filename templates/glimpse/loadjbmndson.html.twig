{# templates/glimpse/loadjson.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/glimpse.css') }}" rel="stylesheet" />
{% endblock %}

{% block js %}
{{ parent() }}

{% endblock %}

{% block body %}
<div id="glimpse" >
    <div class ="heading" >
        <div class="title" > Reading json data </div>
         <div class="title" > {{ filename}} </div>
    </div>
    <div>



{% for jid, ajson in jsondata  %}
<div class="row">

   <div>{{jid}}
               {% if ajson.image  is defined  %}
                             image : {{ajson.image}}
              {% endif %}
        {{ ajson.event}}
        {% if ajson.date  is defined  %}
                      date : {{ajson.date}}
       {% endif %}
          {% if ajson.year  is defined  %}
                             date : {{ajson.year}}
              {% endif %}
       {% if  ajson.person is defined  %}
              name: {{ajson.person}}
       {% endif %}
       {% if ajson.father  is defined  %}
             father : {{ajson.father}}
       {% endif %}
       {% if ajson.groom  is defined  %}
              groom : {{ajson.groom}}
       {% endif %}
       {% if ajson.bride  is defined  %}
              bride : {{ajson.bride}}
        {% endif %}
        {% if ajson.place  is defined  %}
              place : {{ajson.place}}
        {% endif %}
        {% if ajson.note  is defined  %}
              note : {{ajson.note}}
        {% endif %}
        </div>
        <div class="returnbutton button1"> <a  href = "/glimpse/viewjson/{{filename}}/{{jid}}" >View </a> </div>


  </div>


 {% endfor %}

    </div>

</div>

{% endblock %}
