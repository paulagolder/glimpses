{# templates/glimpse/edit.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/glimpse.css') }}" rel="stylesheet" />
{% endblock %}

{% block js %}
{{ parent() }}

{% endblock %}

{% block body %}
<div id="glimpse" >

    <div class ="heading" >
         <div class="title">Glimpse {{glimpse.glimpseid}}</div>
        <div class="returnbutton button1"> <a  href = "{{returnlink}}" >return </a> </div>
           <div class="returnbutton"> <a  href = "/glimpse/showsource/{{glimpse.sourceid}}" >Show All</a> </div>
        <div class="returnbutton"> <a  href = "/source/startinput/{{glimpse.sourceid}}" >Add New Glimpse </a> </div>
    </div>

    <div class="input table">
        <form action="/glimpse/process_edit/{{glimpse.glimpseid}}" method="post"  id="glimpseform"  >
            <div class="row">
                    <div class="label">ID </div>
                    <div class= "cid"> {{glimpse.glimpseid}}</div>
                    <div class="label"> language </div>
                    <div class= "field">{{glimpse.language}} </div>
            </div>
            <div class="row">
                    <div class="label"> sourceid </div>
                    <div class= "cid"> {{glimpse.sourceid}} </div>
                    <div class="label"> page </div>
                    <div class= "icid"> <input class="ref" type="text" name="_ref" value="{{glimpse.ref}}" /> </div>
                    <div class="label"> source </div>
                    <div class= "ltext"> {{glimpse.source}}</div>
                    <div class="linkbutton"><a href="{{source.url}}" target="new" > View Source </a> </div>
            </div>
            <div class="row">
                    <div class="label"> type </div>
                    <div class= "field"> <input class="type" type="text" name="_type" value="{{glimpse.type}}" /> </div>
                    <div class="label"> Qual </div>
                    <div class= "field"> <input class="datequalifier" type="text" name="_datequalifier" value="{{glimpse.datequalifier}}" /> </div>
                    <div class="label"> date </div>
                    <div class= "field"> <input class="date" type="text" name="_gdate" value="{{glimpse.date}}" /> </div>
                    <div class="label"> location </div>
                    <div class= "field"> <input class="ref" type="text" name="_location" value="{{glimpse.location}}" /> </div>
            </div>
            <div class="row">
                    <div class="label"> text </div>
                    <div class= "field"> <input class="text" type="text" name="_text" value="{{glimpse.text}}" /> </div>
            </div>
           <div class="row">
                   <div class="label">image</div>
                   <div class= "field"> <input class="image" type="text" name="_image" value="{{glimpse.image}}" /> </div>
            </div>
        </div>
            <div class="subheading" >
                <div class="title"> roles </div>
            </div>
            <div class="list" >
                 {% for pid, role in roles %}
                 {% if role.role != 'format' %}
                 {%  if role.roleid>0 %}
                  <div class="row">
                      <div class="returnbutton"> <a    href = "/glimpse/deleterole/{{glimpse.glimpseid}}/{{pid}}" >delete </a> </div>
                      <div class="returnbutton">  <a  href = "/glimpse/editrole/{{glimpse.glimpseid}}/{{pid}}" >edit </a>  </div>
                      <div class="cid" >{{role.roleid}} </div>
                      <div class="ctype">{{role.role}}</div>
                      <div class="cname">{{role.name}}</div>
                      <div class="cstext">{{role.predicates}}</div>
                      <div class="ctext">
                      {% for anactor in role.actors %}
                          <div class="actorbutton"><a href = "/actor/showone/{{anactor.actorid}}" > {{anactor.label }}</a></div>
                      {% endfor %}
                 </div>
                 </div>
                 {% else %}
                 <div class="input row">
                        <div class="returnbutton delete" >   </div>
                        <div class="returnbutton edit" >   </div>
                        <div class="cid" >
                            <input type="hidden" name="_role[{{pid}}]['ref']" value="{{role.roleid}}" />
                        </div>
                        <div class="ctype" >
                            <input type="text" name="_role[{{pid}}]['role']" value="{{role.role}}" />
                        </div>
                        <div class="cname" >
                            <input type="text" name="_role[{{pid}}]['name']" value="{{role.name}}" />
                        </div>
                        <div class="cstext" >
                            <input type="text" name="_role[{{pid}}]['predicates']" value="{{role.predicates}}" />
                        </div>
                        <div class="col6"> </div>
                         <div class="col7"> </div>
                    </div>
                    {% endif %}
                      {% endif %}
                    {% endfor %}

            <button type="submit" id="submitbutton"   > enregistrer</button>
        </form>
    </div>
</div>
</div>
{% endblock %}



