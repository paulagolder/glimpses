{# templates/glimpse/json.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/glimpse.css') }}" rel="stylesheet" />
{% endblock %}



{% block body %}
<div id="glimpse" >
    <div class ="heading" >
        <div class="title" > Reading json data </div>
    </div>
    <div class="form">
           <label for="filename">Filename:</label>
           <input type="file" id="fileInput" multiple onchange="showname()"/>

    </div>
</div>
<script src="jquery.js"></script>
<script>
    $(document).ready(function(){
      console.log("Script working properly");
    });
</script>
<script type="text/javascript">
    function showname () {
              var jname = document.getElementById('fileInput');
             /* alert('Selected file: ' + jname.files.item(0).name);
              alert('Selected file: ' + jname.files.item(0).size);
              alert('Selected file: ' + jname.files.item(0).type);*/
               window.open("/glimpse/loadjson/"+jname.files.item(0).name, '_blank');
            };
    </script>
{% endblock %}
