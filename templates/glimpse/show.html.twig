{# templates/glimpse/show.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/glimpse.css') }}" rel="stylesheet" />
{% endblock %}

{% block js %}
{{ parent() }}

{% endblock %}

{% block body %}
<div id="glimpse" >

    <div class ="heading" >
        <div class="title">Glimpse {{glimpse.glimpseid}}</div>
        <div class="returnbutton button1"> <a href = "/glimpse/showall" >return </a> </div>
        <div class="returnbutton">  <a   href = "/glimpse/delete/{{glimpse.glimpseid}}" >delete </a> </div>
        <div class="returnbutton">  <a   href = "/glimpse/edit/{{glimpse.glimpseid}}" >edit </a> </div>
        <div class="returnbutton"><a  href = "/source/startinput/{{glimpse.sourceid}}" >Add New Glimpse </a> </div>
    </div>
    <div class="table">
            <div class="row">
                <div class="label">ID </div>
                <div class= "cid"> {{glimpse.glimpseid}}</div>
                    <div class="label"> language </div>
                    <div class= "cid"> {{glimpse.language}}</div>
                    <div class="label"> sourceid </div>
                    <div class= "cid"> {{glimpse.sourceid}}</div>
                    <div class="label"> source </div>
                    <div class= "cltext"> {{source.title}}</div>
                    <div class= "cluebutton"><a target="_blank" rel="noopener noreferrer" href={{source.url}}>View</a></div>
            </div>
            <div class="row">
                    <div class="label"> date </div>
                    <div class= "cdate"> {{glimpse.date}} </div>
                    <div class="label"> type </div>
                    <div class= "crole"> {{glimpse.type}} </div>
                    <div class="label"> location </div>
                    <div class= "cloc"> {{glimpse.location}}</div>
            </div>
            <div class="row">

                    <div class="label"> text </div>
                    <div class= "field"> {{glimpse.text}} </div>
                    <div class="label"> image </div>
                   <div class= "field">
                                 {#   <div class="returnbutton">{{ ideLink('glimpse.image')}} >View Image </a> </div>#}
                    </div>
            </div>
         </div>

                <div class="subheading" >
                    <div class="title"> roles </div>
                </div>
                <div class="list" >
                        {% for pid, role in roles %}
                        {%  if role.roleid>0 %}
                        <div  class="row" >
                            <div class="returnbutton" >  </div>
                            <div  class="cid"  > {{role.roleid}} </div>
                            <div  class="ctype" >{{role.role}}</div>
                            <div  class="cname" >{{role.name}} </div>
                            <div  class="cmtext" >{{role.predicates}} </div>
                        </div>
                        {% else %}
                        <div class="row">
                            <div  class="col1" >              </div>
                            <div class="col2" >
                                <input type="hidden" name="_role[{{pid}}]['ref']" value="{{role.roleref}}" />
                            </div>
                            <div  class="col3" >{{role.role}} </div>
                            <div  class="col4" >{{role.name}}</div>
                            <div   class="col5" >{{role.predicates}}</div>
                        </div>
                        {% endif %}
                        {% endfor %}
                </div>
                <div class="subheading" >
                                <div class="title"> Possible duplicates </div>
                </div>
                {% for dup in duplicates %}
                 {% if glimpse.glimpseid != dup.glimpseid %}
                 <div class="list">
                    <div class="row" >
                        <div class="returnbutton">  <a   href = "/glimpse/showone/{{dup.glimpseid}}" >View</a> </div>
                        <div class="cid" >{{dup.glimpseid}}   </div>
                        <div class="cmtext">{{ FormatEvent(dup)}}   </div>
                     </div>
                     </div>
                   {% endif %}
                {% endfor %}
</div>
{% endblock %}




