{# templates/glimpse/show.html.twig #}

{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<link href="{{ asset('css/glimpse.css') }}" rel="stylesheet" />
{% endblock %}

{% block js %}
{{ parent() }}

{% endblock %}

{% block body %}
<div id="glimpse" >

    <div class ="heading" >
        <div class="title">Glimpse {{glimpse.glimpseid}}</div>
        <div class="returnbutton button1"> <a href = "/glimpse/showall" >return </a> </div>
        <div class="returnbutton">  <a   href = "/glimpse/delete/{{glimpse.glimpseid}}" >delete </a> </div>
        <div class="returnbutton">  <a   href = "/glimpse/edit/{{glimpse.glimpseid}}" >edit </a> </div>
        <div class="returnbutton"><a  href = "/source/startinput/{{glimpse.sourceid}}" >Add New Glimpse </a> </div>
    </div>
    <div class="glimpseform">
            <div class="row">
            <div class="inputpair" >
                <div class="label">ID </div>
                <div class= "field"> {{glimpse.glimpseid}}</div>
                </div>
                <div class="inputpair" >
                    <div class="label"> language </div>
                    <div class= "field"> {{glimpse.language}}</div>
                    </div>
                    <div class="inputpair" >
                    <div class="label"> sourceid </div>
                    <div class= "field"> {{glimpse.sourceid}}</div>
                    </div>
                        <div class="inputpair" >
                    <div class="label"> source </div>
                    <div class= "field"> {{source.title}}</div>
                    </div>
                    <div class="inputpair" >
                    <div class="label"> source </div>
                    <div class= "field"><a target="_blank" rel="noopener noreferrer" href={{source.url}}>View</a></div>
                    </div>
                </div>

            <div class="row">
            <div class="inputpair" >
                    <div class="label"> type </div>
                    <div class= "field"> {{glimpse.type}} </div>
            </div>
            <div class="inputpair" >
                    <div class="label"> location </div>
                    <div class= "field"> {{glimpse.location}}</div>
            </div>
            </div>
                <div class="row">
                <div class="inputpair" >
                    <div class="label"> date </div>
                    <div class= "field"> {{glimpse.date}} </div>
                        </div>
            <div class="inputpair" >
                    <div class="label"> text </div>
                    <div class= "field"> {{glimpse.text}} </div>
                    </div>

             <div class="inputpair" >
                                <div class="label"> image </div>
                                <div class= "field">
                                 {#   <div class="returnbutton">{{ ideLink('glimpse.image')}} >View Image </a> </div>#}
                                    </div>
             </div>
                            </div>
                               </div>
                <div class="subheading" >
                    <div class="title"> roles </div>
                </div>
                <div class="roleTable" >
                        {% for pid, role in roles %}
                        {%  if role.roleid>0 %}
                        <div  class="row" >
                            <div class="col1" >  </div>
                            <div  class="col2"  > {{role.roleid}} </div>
                            <div  class="col3" >{{role.role}}</div>
                            <div  class="col4" >{{role.name}} </div>
                            <div  class="col5" >{{role.predicates}} </div>
                        </div>
                        {% else %}
                        <div class="row">
                            <div  class="col1" >              </div>
                            <div class="col2" >
                                <input type="hidden" name="_role[{{pid}}]['ref']" value="{{role.roleref}}" />
                            </div>
                            <div  class="col3" >{{role.role}} </div>
                            <div  class="col4" >{{role.name}}</div>
                            <div   class="col5" >{{role.predicates}}</div>
                        </div>
                        {% endif %}
                        {% endfor %}
                </div>
</div>
{% endblock %}




